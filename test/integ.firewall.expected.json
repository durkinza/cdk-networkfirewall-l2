                "Action": "DROP",
                "Header": {
                  "Destination": "$HOME_NET",
                  "DestinationPort": "$WEB_PORTS",
                  "Direction": "FORWARD",
                  "Protocol": "TCP",
                  "Source": "10.10.0.0/16",
                  "SourcePort": "any"
                },
                "RuleOptions": [
                  {
                    "Keyword": "sid",
                    "Settings": [
                      "1234"
                    ]
