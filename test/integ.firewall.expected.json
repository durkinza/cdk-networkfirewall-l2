    "MyStateful5TupleRuleGroupE35C4D46": {
      "Type": "AWS::NetworkFirewall::RuleGroup",
      "Properties": {
        "Capacity": 100,
        "RuleGroup": {
          "RuleVariables": {
            "IPSets": {
              "HOME_NET": {
                "Definition": [
                  "10.0.0.0/16",
                  "10.10.0.0/16"
                ]
              }
            },
            "PortSets": {
